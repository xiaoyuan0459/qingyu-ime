<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AppTheme" parent="Base.Qingyu.AppTheme">
        <item name="colorPrimary">@color/pref_accent</item>
        <item name="colorOnPrimary">#10223C</item>
        <item name="colorPrimaryContainer">#233B5D</item>
