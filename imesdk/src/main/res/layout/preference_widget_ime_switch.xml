<?xml version="1.0" encoding="utf-8"?>
<!--
  胶囊开关控件。id 必须是 androidx.preference 的 switchWidget，
  SwitchPreferenceCompat 靠它同步选中态；换成别的 id 开关就不会跟着偏好项跳动了。
-->
<com.qingyu.imemodule.view.preference.FlymeSwitch xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:duplicateParentState="true"
    android:focusable="false"
    android:importantForAccessibility="no" />
