<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <!-- 入口图标配有 entrance_name 文字标签，图标本身不重复描述 -->
    <ImageView
        android:id="@+id/entrance_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription"/>

    <TextView
        android:id="@+id/entrance_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/entrance_image"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:textSize="12sp"/>
    <ImageView
        android:id="@+id/entrance_option"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="15dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/accessibility_menu_more"/>
</RelativeLayout>
